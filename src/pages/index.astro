---
import Online from '../components/Online.astro';
import Lobby from '../components/Lobby.astro';
import Race from '../components/Race.astro';
import Dialogs from '../components/Dialogs.astro';
import '../styles/game.css';
const revision = process.env['GITHUB_SHA'] ?? 'local';
---

<!doctype html>
<html lang="ja">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    /><meta name="theme-color" content="#057bff" /><meta
      name="description"
      content="自動加速とチャージダッシュで競うビリビリレーサーズ。壁にふれたらスタートへ。無料・ログイン不要の1人用レーシングゲーム。"
    /><link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    /><meta name="build-revision" content={revision} /><title>
      ビリビリレーサーズ | ひとりでレース
    </title></head
  ><body
    ><main id="app"><Lobby /><Online /><Race /><Dialogs /></main><noscript
      ><p class="noscript">
        このゲームを遊ぶにはJavaScriptを有効にしてください。
      </p></noscript
    ><script>
      import '../game/main';
    </script></body
  >
</html>

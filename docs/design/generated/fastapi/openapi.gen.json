    "schemas": {
      "Command": {
        "additionalProperties": false,
        "properties": {
          "course": {
            "default": 0,
            "minimum": 0.0,
            "title": "Course",
            "type": "integer"
          },
          "frames": {
            "items": {
              "$ref": "#/components/schemas/Frame"
            },
            "maxItems": 120,
            "title": "Frames",

{
  "name": "biribiri-racers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check && tsc --noEmit -p tsconfig.tests.json",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "format": "prettier --write src tests scripts *.mjs *.ts *.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.mjs *.ts *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}

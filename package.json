{
  "name": "biribiri-racers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit -p tsconfig.tests.json",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "format": "prettier --write src tests scripts *.mjs *.ts *.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.mjs *.ts *.json .github/workflows/*.yml",
    "dev:api": "uv run --locked --project backend uvicorn app.local:app --host 127.0.0.1 --port 4322",
    "data:generate": "node --import tsx scripts/export-game.ts",
    "data:check": "node --import tsx scripts/export-game.ts --check",
    "test:physics-parity": "mkdir -p .build && node --import tsx scripts/physics-trace.ts > .build/physics-trace.json",
    "infra:check": "tsc -p infra/tsconfig.json",
    "infra:synth": "bash scripts/package-lambda.sh && node --import tsx infra/app.ts",
    "docs:generate": "python tools/quintflow.py generate && uv run --locked --project backend app-docs && bash scripts/design-cdk.sh && python scripts/requirements-pages.py",
    "docs:check": "python tools/quintflow.py check && uv run --locked --project backend app-docs --check && bash scripts/design-cdk.sh --check && python scripts/requirements-pages.py --check",
    "test:online": "playwright test -c playwright.online.config.ts",
    "build:aws": "ASTRO_TELEMETRY_DISABLED=1 PUBLIC_SITE_BASE=/ PUBLIC_API_BASE=/api astro build"
  },
  "dependencies": {
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "aws-cdk": "^2.1140.0",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
